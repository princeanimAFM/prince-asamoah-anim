# Copy to .env.local for local development, and set the same names in Netlify
# (Site configuration > Environment variables). Never commit real values.

# How many Ghana cedis make £1, for showing approximate cedi prices. Customers always pay in pounds.
# Leave empty to show pounds only. Read when the site is built, so redeploy after changing it.
GHS_PER_GBP=

# Stripe secret key (Developers > API keys). Use sk_test_... while the shop is in preview:
# live keys are refused until SITE.preview is false in src/lib/site.ts.
STRIPE_SECRET_KEY=

# The shop's public address, used for Stripe's return links and product images.
SITE_URL=https://kacecollections.netlify.app
