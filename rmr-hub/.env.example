# ---- Database -------------------------------------------------------------
# Leave empty to use a local file database in ./data (fine for trying it out).
# For the live app use a Postgres URL, e.g. from Supabase or Neon (free tiers).
DATABASE_URL=

# ---- Sign in with Google (also used for Google Drive and Gmail) ------------
# Create OAuth credentials at https://console.cloud.google.com (see README).
# AUTH_SECRET: run `npx auth secret` to generate one.
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Only this Google account can sign in.
ALLOWED_EMAIL=prince@rmrdevworks.co.uk

# ---- Daily job (Monzo sync + automatic reminders) ---------------------------
# Any long random text; the daily job (Netlify scheduled function or Vercel cron) sends it.
CRON_SECRET=

# ---- Monzo sync (optional, see README) --------------------------------------
# Your site address, used for the Monzo sign-in redirect (not needed on Netlify).
APP_URL=
MONZO_CLIENT_ID=
MONZO_CLIENT_SECRET=

# ---- Local development only -----------------------------------------------
# Skip sign-in while trying the app on your own computer. Ignored in production.
DEV_SKIP_AUTH=false
