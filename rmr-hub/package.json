{
  "name": "rmr-hub",
  "version": "0.1.0",
  "private": true,
  "description": "RMR Dev Works business assistant: clients, hours, invoices, payments and tax",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "db:migrate": "node scripts/migrate.mjs",
